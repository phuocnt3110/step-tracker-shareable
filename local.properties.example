# === NPH SDK Keys ===
# File này chỉ là mẫu format. KHÔNG điền real keys vào đây.
# Tạo file local.properties (gitignored) với real values khi build release.
#
# Khi dev, KHÔNG cần tạo local.properties — app tự dùng Google test IDs.
# Các SDK tracking key để trống = SDK đó không được init.

# ── Ads ──────────────────────────────────────────────
# AdMob App ID (required)
NPH_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# ── Tracking: Meta/Facebook ──────────────────────────
# Meta App ID + Client Token (từ Meta for Developers console)
NPH_META_APP_ID=YOUR_META_APP_ID
NPH_META_CLIENT_TOKEN=YOUR_META_CLIENT_TOKEN

# ── Tracking: TikTok ─────────────────────────────────
# TikTok App ID (từ TikTok Ads Manager > Assets > Events > App Events)
NPH_TIKTOK_APP_ID=YOUR_TIKTOK_APP_ID

# ── Tracking: Adjust (optional) ──────────────────────
NPH_ADJUST_TOKEN=YOUR_ADJUST_TOKEN

# ── Tracking: AppsFlyer (optional) ───────────────────
NPH_APPSFLYER_KEY=YOUR_APPSFLYER_KEY

# ── Android SDK ──────────────────────────────────────
# Auto-filled by Android Studio — KHÔNG commit
# sdk.dir=C\:\\Users\\...\\Android\\Sdk
